# Hosted API (Render) — used in production.
# For local dev swap to http://localhost:4000
NEXT_PUBLIC_API_URL=https://cut-smartfix-api.onrender.com

# Supabase project credentials (public / anon — safe to expose in a browser bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NOTE: SUPABASE_SERVICE_ROLE_KEY must NEVER be set here.
# It belongs only in services/api/.env (server-side, never shipped to a browser).
