# ─── API ─────────────────────────────────────────────────────────────────────
# For physical devices / emulators on the LAN, replace with your machine's
# LAN IP address (e.g. http://192.168.x.x:4000).
# Run `ip addr` (Linux/macOS) or `ipconfig` (Windows) to find your IP.
# Simulator / Expo Go on the same machine: http://localhost:4000 works fine.
EXPO_PUBLIC_API_URL=http://localhost:4000

# ─── Supabase ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
