# Hosted API (Render) — used in production and for testing with a physical device.
# For local development against a local API server, replace with your LAN IP,
# e.g. http://192.168.x.x:4000  (run `ip addr` / `ipconfig` to find it).
EXPO_PUBLIC_API_URL=https://cut-smartfix-api.onrender.com

# Supabase project credentials (public / anon — safe to expose in the bundle)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
